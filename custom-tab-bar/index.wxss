/* custom-tab-bar/index.wxss - Floating Pill Dock (no pressed effect, clear selected state) */

.tabbar-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  padding-top: 16rpx;
  z-index: 999;
  pointer-events: none;
}

.tabbar-dock {
  pointer-events: auto;
  width: 100%;
  max-width: 600px;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  background-color: var(--tabbar-bg, #232323);
  box-shadow: var(--tabbar-shadow, 0 16rpx 48rpx rgba(35, 35, 35, 0.16));
  border-radius: 40rpx;
  padding: 12rpx;
}

/* Tab item press feedback via hover-class ("press-deep" from app.wxss) */
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0 10rpx;
  border-radius: 28rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

/* Selected state: inverted cream pill */
.tab-item-active {
  background-color: var(--tabbar-active-bg, #F2EFE3);
}

.tab-label {
  font-size: 22rpx;
  line-height: 30rpx;
  margin-top: 6rpx;
  font-weight: 500;
  color: var(--tabbar-text, #F2EFE3);
  letter-spacing: 0.5rpx;
}

.tab-label-active {
  color: var(--tabbar-active-text, #232323);
  font-weight: 600;
}

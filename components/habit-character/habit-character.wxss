.character-box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.character-img {
  display: block;
}

.animate-gentle {
  animation: floatGentle 3.5s ease-in-out infinite;
}

@keyframes floatGentle {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

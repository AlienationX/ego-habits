/* components/nav-back/nav-back.wxss */
.nav-back {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background-color: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

/* Component-scoped press class (style-isolated) */
.nav-press {
  transform: scale(0.9);
  opacity: 0.8;
}

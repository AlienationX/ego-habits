.tabbar-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  padding-top: 16rpx;
  z-index: 999;
  pointer-events: none;
}

.tabbar-dock {
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--tabbar-bg, #232323);
  box-shadow: 0 16rpx 44rpx rgba(0, 0, 0, 0.22);
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
  gap: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 124rpx;
  padding: 12rpx 16rpx 8rpx;
  border-radius: 999rpx;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.tab-item-active {
  background-color: var(--tabbar-pill-active, #323532);
}

.tab-label {
  font-size: 20rpx;
  line-height: 28rpx;
  margin-top: 4rpx;
  font-weight: 500;
  color: var(--tabbar-text, #8E928A);
  letter-spacing: 0.5rpx;
  transition: color 0.2s ease;
}

.label-active {
  color: var(--tabbar-text-active, #FFFFFF);
  font-weight: 600;
}

<view class="tabbar-container">
  <view class="tabbar-dock">
    <view 
      wx:for="{{tabs}}" 
      wx:key="key" 
      class="tab-item {{current === item.key ? 'tab-item-active' : ''}}"
      data-key="{{item.key}}"
      data-path="{{item.path}}"
      bindtap="onTabSelect"
    >
      <habit-icon 
        name="{{item.icon}}" 
        size="38" 
        active="{{current === item.key}}"
      />
      <text class="tab-label {{current === item.key ? 'label-active' : ''}}">{{item.label}}</text>
    </view>
  </view>
</view>

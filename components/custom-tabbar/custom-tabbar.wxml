<view class="tabbar-container">
  <view class="tabbar-dock">
    <view 
      wx:for="{{tabs}}" 
      wx:key="key" 
      class="tab-item"
      data-key="{{item.key}}"
      data-path="{{item.path}}"
      bindtap="onTabSelect"
    >
      <habit-icon 
        name="{{item.icon}}" 
        size="44" 
        color="#F2EFE3"
      />
      <text class="tab-label">{{item.label}}</text>
    </view>
  </view>
</view>

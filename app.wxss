/**
 * EgoHabits - Global Stylesheet
 * 8px Rhythm System · Design System Foundation
 */
@import "./styles/theme.wxss";

/* Global Box Sizing & Font Stack */
page {
  background-color: var(--bg-page);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow-x: hidden;
}

view, text, image, button, input, scroll-view {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

/* Base Responsive Container for Multi-Platform (Phone, iPad, PC) */
.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  width: 100%;
  max-width: 600px;
  margin: 0 auto;
  position: relative;
  background-color: var(--bg-page);
}

/* Typography Hierarchy (Matching Design 08 Specs) */
.text-title-24 {
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

.text-headline-20 {
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.text-body-14 {
  font-size: 28rpx;
  line-height: 42rpx;
  font-weight: 400;
  color: var(--text-secondary);
}

.text-label-12 {
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  color: var(--text-muted);
}

/* Button Component Styles (Matching Component Lab 08) */
.btn-moru {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 48rpx;
  border: none;
  cursor: pointer;
  transition: opacity 0.15s ease, transform 0.1s ease;
}

.btn-moru:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-ink {
  background-color: var(--btn-ink-bg);
  color: var(--btn-ink-text);
}

.btn-green {
  background-color: var(--btn-green-bg);
  color: var(--btn-green-text);
}

.btn-sage {
  background-color: var(--btn-sage-bg);
  color: var(--btn-sage-text);
}

/* ===== Press feedback (attach via hover-class) ===== */
.press {
  transform: scale(0.96);
  opacity: 0.85;
}

.press-soft {
  transform: scale(0.98);
  opacity: 0.9;
}

.press-deep {
  transform: scale(0.9);
  opacity: 0.8;
}

/* Safe Area Inset Helpers */
.safe-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

/* Sub-page top bar (holds the nav-back button above the title) */
.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  padding-top: calc(48rpx + env(safe-area-inset-top));
  margin-bottom: 24rpx;
}

.safe-tabbar-space {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

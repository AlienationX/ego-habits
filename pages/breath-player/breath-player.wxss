/* pages/breath-player/breath-player.wxss */
.page-body {
  min-height: 100vh;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.nav-header {
  padding-top: 0;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.tag-label {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.headline-title {
  font-size: 42rpx;
  line-height: 52rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

/* Ball stage */
.ball-stage {
  position: relative;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.ball-ring {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-light);
  opacity: 0.5;
}

.breath-ball {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  box-shadow: 0 16rpx 40rpx rgba(35, 35, 35, 0.14);
}

/* Card tints */
.card-tint-blue { background-color: var(--bg-card-blue); }
.card-tint-mint { background-color: var(--bg-card-mint); }
.card-tint-sage { background-color: var(--bg-card-sage); }
.card-tint-cream { background-color: var(--bg-card-cream); }
.card-tint-mint-soft { background-color: var(--bg-card-mint-soft); }
.card-tint-sage-soft { background-color: var(--bg-card-sage-soft); }
.card-tint-blue-soft { background-color: var(--bg-card-blue-soft); }

/* Center section (ready text / phase) */
.center-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  margin-bottom: 12rpx;
}

.ready-text {
  font-size: 26rpx;
  line-height: 38rpx;
  color: var(--text-secondary);
  text-align: center;
}

.phase-label {
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.phase-count {
  font-size: 96rpx;
  line-height: 120rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -2rpx;
}

/* Duration selector */
.duration-section {
  display: flex;
  flex-direction: column;
  margin-bottom: 36rpx;
}

.duration-label {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
}

.duration-pills {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.duration-pill {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background-color: var(--bg-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.duration-pill-active {
  background-color: var(--btn-ink-bg);
}

.duration-pill-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.duration-pill-active .duration-pill-text {
  color: var(--btn-ink-text);
}

/* Stats row (running) */
.stats-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: 36rpx;
}

.stat-chip {
  flex: 1;
  background-color: var(--bg-card);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
}

.stat-chip-label {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--text-muted);
  margin-bottom: 6rpx;
}

.stat-chip-val {
  font-size: 40rpx;
  line-height: 48rpx;
  font-weight: 800;
  color: var(--text-primary);
}

/* Start / end CTA */
.start-wrap {
  width: 100%;
  margin-top: auto;
  padding-top: 24rpx;
}

.start-btn {
  width: 100%;
  padding: 32rpx 0;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(35, 35, 35, 0.16);
}

.start-text {
  font-size: 30rpx;
  font-weight: 700;
}

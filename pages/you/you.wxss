/* pages/you/you.wxss */
.content-scroll {
  flex: 1;
  height: 100vh;
}

.page-body {
  padding-top: 40rpx;
  padding-left: 48rpx;
  padding-right: 48rpx;
  display: flex;
  flex-direction: column;
}

/* Header */
.header-section {
  padding-top: calc(70rpx + env(safe-area-inset-top));
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
}

.tag-label {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.headline-title {
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

/* Profile Card */
.profile-card {
  background-color: var(--bg-card-mint);
  border-radius: 36rpx;
  padding: 44rpx 36rpx 36rpx;
  display: flex;
  flex-direction: column;
  margin-bottom: 40rpx;
}

.profile-top-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 32rpx;
}

.profile-avatar-wrap {
  width: 130rpx;
  height: 130rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-user-info {
  display: flex;
  flex-direction: column;
}

.user-nickname {
  font-size: 38rpx;
  line-height: 48rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.user-handle {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-secondary);
}

.profile-divider {
  height: 1rpx;
  background-color: rgba(35, 35, 35, 0.08);
  width: 100%;
  margin-bottom: 28rpx;
}

.profile-stats-row {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  gap: 80rpx;
  padding-left: 8rpx;
}

.stat-col {
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 44rpx;
  line-height: 52rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.stat-lbl {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--text-secondary);
}

/* Section Group */
.section-group {
  display: flex;
  flex-direction: column;
  margin-bottom: 36rpx;
}

.group-title {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

/* Badges Gallery */
.badges-scroll {
  width: 100%;
}

.badges-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 8rpx 0;
}

.badge-card {
  width: 170rpx;
  background-color: var(--bg-card);
  border-radius: 32rpx;
  padding: 24rpx 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
  flex-shrink: 0;
}

.badge-card-locked {
  opacity: 0.6;
  filter: grayscale(0.5);
}

.badge-character-wrap {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.badge-card-title {
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 12rpx;
}

.badge-status-pill {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background-color: var(--bg-pill);
}

.status-unlocked {
  background-color: var(--green);
}

.badge-status-text {
  font-size: 18rpx;
  line-height: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.status-unlocked .badge-status-text {
  color: #FFFFFF;
}

/* Notes Stream */
.notes-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.note-card {
  background-color: var(--bg-card);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--border-light);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.note-card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.note-meta-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.note-habit-name {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.note-date {
  font-size: 20rpx;
  color: var(--text-muted);
}

.note-content {
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--text-secondary);
  font-style: italic;
}

.empty-notes-box {
  background-color: var(--bg-pill);
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-notes-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* Settings List */
.settings-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.setting-item {
  border-radius: 28rpx;
  padding: 32rpx 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.setting-item-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.setting-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* Modals Overlay */
.modal-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

.modal-card {
  width: 100%;
  max-width: 600px;
  background-color: var(--bg-page);
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 44rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.12);
  animation: slideUp 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 36rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.modal-close {
  font-size: 32rpx;
  color: var(--text-muted);
  padding: 8rpx 16rpx;
}

/* Badge Modal Card */
.badge-modal-card {
  width: 100%;
  max-width: 600rpx;
  background-color: var(--bg-card);
  border-radius: 44rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  margin-bottom: 20vh;
  animation: slideUp 0.25s ease;
}

.badge-modal-character {
  margin-bottom: 24rpx;
}

.badge-modal-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.badge-modal-desc {
  font-size: 26rpx;
  line-height: 38rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 32rpx;
}

.badge-modal-progress {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 36rpx;
}

.progress-track {
  width: 100%;
  height: 12rpx;
  background-color: var(--bg-pill);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background-color: var(--green);
  border-radius: 999rpx;
}

.badge-modal-prog-text {
  font-size: 22rpx;
  color: var(--text-muted);
}

.badge-modal-btn {
  width: 100%;
  padding: 26rpx 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-modal-btn-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--btn-ink-text);
}

/* Reminders Modal */
.modal-title-wrap {
  display: flex;
  flex-direction: column;
}

.modal-subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.reminder-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.reminder-left {
  display: flex;
  flex-direction: column;
}

.reminder-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.reminder-sub {
  font-size: 22rpx;
  color: var(--text-muted);
}

.reminder-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.time-picker-pill {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background-color: var(--bg-pill);
}

.time-picker-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.reminders-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.reminder-action-btn {
  width: 100%;
  padding: 26rpx 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reminder-action-btn-text {
  font-size: 26rpx;
  font-weight: 700;
}

.btn-text-dark {
  color: #232323;
}

/* Preferences Rows */
.pref-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
  gap: 16rpx;
}

.pref-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.pref-options {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.pref-opt-pill {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background-color: var(--bg-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.pref-opt-active {
  background-color: var(--btn-ink-bg);
}

.pref-opt-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.pref-opt-active .pref-opt-text {
  color: var(--btn-ink-text);
}

.pref-clear-row {
  margin-top: 24rpx;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background-color: var(--bg-card);
  border: 1rpx solid var(--border-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pref-clear-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #D34B4B;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

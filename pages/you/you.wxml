<!-- pages/you/you.wxml - Your Space -->
<view class="page-container {{themeClass}}">
  <scroll-view class="content-scroll" scroll-y enable-passive>
    <view class="page-body safe-tabbar-space">
      
      <!-- Top Title -->
      <view class="header-section">
        <text class="tag-label">{{tTag}}</text>
        <text class="headline-title">{{tYouHeadline}}</text>
      </view>

      <!-- Profile Card -->
      <view class="profile-card">
        <view class="profile-top-row">
          <view class="profile-avatar-wrap">
            <habit-character name="avatar" size="130" animate="{{true}}" />
          </view>
          <view class="profile-user-info">
            <text class="user-nickname">{{profile.nickname}}</text>
            <text class="user-handle">{{profile.handle}}</text>
          </view>
        </view>

        <view class="profile-divider"></view>

        <view class="profile-stats-row">
          <view class="stat-col">
            <text class="stat-num">{{profile.totalCompleted}}</text>
            <text class="stat-lbl">{{tStatCompletedLabel}}</text>
          </view>
          <view class="stat-col">
            <text class="stat-num">{{profile.streakDays}}</text>
            <text class="stat-lbl">{{tStatStreakLabel}}</text>
          </view>
        </view>
      </view>

      <!-- Milestone Badges Gallery Section -->
      <view class="section-group">
        <view class="group-header">
          <text class="group-title">{{tMilestoneSection}}</text>
        </view>
        
        <scroll-view class="badges-scroll" scroll-x enable-passive>
          <view class="badges-row">
            <view
              wx:for="{{badges}}"
              wx:key="id"
              class="badge-card {{item.unlocked ? 'badge-card-unlocked' : 'badge-card-locked'}}"
              data-id="{{item.id}}"
              hover-class="press-soft"
              hover-stay-time="120"
              bindtap="onTapBadge"
            >
              <view class="badge-character-wrap">
                <habit-character name="{{item.character}}" size="88" />
              </view>
              <text class="badge-card-title">{{item.title}}</text>
              <view class="badge-status-pill {{item.unlocked ? 'status-unlocked' : ''}}">
                <text class="badge-status-text">{{item.unlocked ? tUnlocked : item.progress + '%'}}</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- Habit Notes Stream Section -->
      <view class="section-group">
        <text class="group-title">{{tNotesSection}}</text>
        
        <view wx:if="{{checkinNotes.length > 0}}" class="notes-list">
          <view wx:for="{{checkinNotes}}" wx:key="id" class="note-card">
            <view class="note-card-header">
              <view class="note-meta-left">
                <habit-character name="{{item.character}}" size="48" />
                <text class="note-habit-name">{{item.habitName}}</text>
              </view>
              <text class="note-date">{{item.date}}</text>
            </view>
            <text class="note-content">“{{item.note}}”</text>
          </view>
        </view>
        <view wx:else class="empty-notes-box">
          <text class="empty-notes-text">{{tNotesEmpty}}</text>
        </view>
      </view>

      <!-- Settings Section: On your own terms -->
      <view class="section-group">
        <text class="group-title">{{tSettingsSection}}</text>
        
        <view class="settings-list">
          <view class="setting-item" hover-class="press-soft" hover-stay-time="120" bindtap="onTapReminders">
            <view class="setting-item-left">
              <habit-icon name="bell" size="36" color="var(--text-primary)" />
              <text class="setting-name">{{tGentleReminders}}</text>
            </view>
            <habit-icon name="arrow" size="28" color="var(--text-muted)" />
          </view>

          <view class="setting-item" hover-class="press-soft" hover-stay-time="120" bindtap="onOpenPreferences">
            <view class="setting-item-left">
              <habit-icon name="settings" size="36" color="var(--text-primary)" />
              <text class="setting-name">{{tPreferences}}</text>
            </view>
            <habit-icon name="arrow" size="28" color="var(--text-muted)" />
          </view>
        </view>
      </view>

    </view>
  </scroll-view>

  <!-- Badge Detail Popover Modal -->
  <view wx:if="{{showBadgeModal && selectedBadge}}" class="modal-overlay" bindtap="onCloseBadgeModal">
    <view class="badge-modal-card" catchtap="preventProp">
      <view class="badge-modal-character">
        <habit-character name="{{selectedBadge.character}}" size="160" animate="{{true}}" />
      </view>
      <text class="badge-modal-title">{{selectedBadge.title}}</text>
      <text class="badge-modal-desc">{{selectedBadge.desc}}</text>
      
      <view class="badge-modal-progress">
        <view class="progress-track">
          <view class="progress-bar progress-bar-fill" style="width: {{selectedBadge.progress}}%;"></view>
        </view>
        <text class="badge-modal-prog-text">{{selectedBadge.current}} / {{selectedBadge.target}} ({{selectedBadge.progress}}%)</text>
      </view>

      <view class="btn-moru btn-ink badge-modal-btn" hover-class="press" hover-stay-time="120" bindtap="onCloseBadgeModal">
        <text class="badge-modal-btn-text">{{selectedBadge.unlocked ? tUnlocked : tLocked}}</text>
      </view>
    </view>
  </view>

  <!-- Reminders Modal -->
  <view wx:if="{{showRemindersModal}}" class="modal-overlay" bindtap="onCloseReminders">
    <view class="modal-card" catchtap="preventProp">
      <view class="modal-header">
        <view class="modal-title-wrap">
          <text class="modal-title">{{tRemindersTitle}}</text>
          <text class="modal-subtitle">{{tRemindersSub}}</text>
        </view>
        <text class="modal-close" hover-class="press-deep" hover-stay-time="120" bindtap="onCloseReminders">✕</text>
      </view>

      <!-- Morning Reminder Row -->
      <view class="reminder-row">
        <view class="reminder-left">
          <text class="reminder-label">{{tMorning}}</text>
          <text class="reminder-sub">{{tMorningSub}}</text>
        </view>
        <view class="reminder-right">
          <picker mode="time" value="{{reminders.morningTime}}" bindchange="onChangeMorningTime">
            <view class="time-picker-pill">
              <text class="time-picker-text">{{reminders.morningTime}}</text>
            </view>
          </picker>
          <switch checked="{{reminders.morningEnabled}}" color="var(--green)" bindchange="onToggleMorning" />
        </view>
      </view>

      <!-- Evening Reminder Row -->
      <view class="reminder-row">
        <view class="reminder-left">
          <text class="reminder-label">{{tEvening}}</text>
          <text class="reminder-sub">{{tEveningSub}}</text>
        </view>
        <view class="reminder-right">
          <picker mode="time" value="{{reminders.eveningTime}}" bindchange="onChangeEveningTime">
            <view class="time-picker-pill">
              <text class="time-picker-text">{{reminders.eveningTime}}</text>
            </view>
          </picker>
          <switch checked="{{reminders.eveningEnabled}}" color="var(--green)" bindchange="onToggleEvening" />
        </view>
      </view>

      <!-- Action Buttons -->
      <view class="reminders-actions">
        <view class="btn-moru btn-green reminder-action-btn" hover-class="press" hover-stay-time="120" bindtap="onAddCalendarReminders">
          <text class="reminder-action-btn-text">{{tAddToCalendar}}</text>
        </view>
        <view class="btn-moru btn-sage reminder-action-btn" hover-class="press" hover-stay-time="120" bindtap="onSubscribeNotice">
          <text class="reminder-action-btn-text btn-text-dark">{{tSubscribeMsg}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Preferences Modal -->
  <view wx:if="{{showPrefModal}}" class="modal-overlay" bindtap="onClosePreferences">
    <view class="modal-card" catchtap="preventProp">
      <view class="modal-header">
        <text class="modal-title">{{tPrefTitle}}</text>
        <text class="modal-close" hover-class="press-deep" hover-stay-time="120" bindtap="onClosePreferences">✕</text>
      </view>

      <!-- Language Switch -->
      <view class="pref-row">
        <text class="pref-label">{{tLanguage}}</text>
        <view class="pref-options">
          <view 
            hover-class="press-soft" hover-stay-time="120" class="pref-opt-pill {{langPref === 'en' ? 'pref-opt-active' : ''}}"
            bindtap="onSelectLanguage"
            data-lang="en"
          >
            <text class="pref-opt-text">English</text>
          </view>
          <view 
            hover-class="press-soft" hover-stay-time="120" class="pref-opt-pill {{langPref === 'zh' ? 'pref-opt-active' : ''}}"
            bindtap="onSelectLanguage"
            data-lang="zh"
          >
            <text class="pref-opt-text">中文 (Chinese)</text>
          </view>
        </view>
      </view>

      <!-- Theme Switch -->
      <view class="pref-row">
        <text class="pref-label">{{tTheme}}</text>
        <view class="pref-options">
          <view 
            hover-class="press-soft" hover-stay-time="120" class="pref-opt-pill {{currentTheme === 'auto' ? 'pref-opt-active' : ''}}"
            bindtap="onSelectTheme"
            data-theme="auto"
          >
            <text class="pref-opt-text">Auto</text>
          </view>
          <view 
            hover-class="press-soft" hover-stay-time="120" class="pref-opt-pill {{currentTheme === 'light' ? 'pref-opt-active' : ''}}"
            bindtap="onSelectTheme"
            data-theme="light"
          >
            <text class="pref-opt-text">Light</text>
          </view>
          <view 
            hover-class="press-soft" hover-stay-time="120" class="pref-opt-pill {{currentTheme === 'dark' ? 'pref-opt-active' : ''}}"
            bindtap="onSelectTheme"
            data-theme="dark"
          >
            <text class="pref-opt-text">Dark</text>
          </view>
        </view>
      </view>

      <!-- Clear Data -->
      <view class="pref-clear-row" hover-class="press-soft" hover-stay-time="120" bindtap="onClearCache">
        <text class="pref-clear-text">{{tClearData}}</text>
      </view>

    </view>
  </view>
</view>

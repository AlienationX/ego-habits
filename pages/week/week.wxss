/* pages/week/week.wxss */
.content-scroll {
  flex: 1;
  height: 100vh;
}

.page-body {
  padding-top: 40rpx;
  padding-left: 48rpx;
  padding-right: 48rpx;
  display: flex;
  flex-direction: column;
}

/* Header */
.header-section {
  padding-top: calc(70rpx + env(safe-area-inset-top));
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
}



.date-label {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.headline-title {
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

/* Week history pager (prev / range / next) — below the view toggle, chart mode only */
.week-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.week-nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.week-nav-btn-disabled {
  opacity: 0.35;
}

.week-nav-range {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
}

.tag-label {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

/* Quick "back to this week" pill, right-aligned in the toggle row */
.back-this-week-pill {
  margin-left: auto;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background-color: var(--btn-sage-bg);
}

.back-this-week-text {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: var(--btn-sage-text);
}

/* View toggle: chart / calendar + share pill */
.view-toggle {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.view-toggle-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.view-share-pill {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background-color: var(--bg-pill);
  cursor: pointer;
  box-sizing: border-box;
}

.view-share-text {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.view-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background-color: var(--bg-pill);
}

.view-pill-active {
  background-color: var(--btn-ink-bg);
}

.view-pill-text {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.view-pill-text-active {
  color: var(--btn-ink-text);
}

/* Calendar view */
.calendar-card {
  background-color: var(--bg-card);
  border-radius: 36rpx;
  padding: 36rpx;
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
}

.cal-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.cal-title {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.cal-head-row {
  display: flex;
  flex-direction: row;
  margin-bottom: 8rpx;
}

.cal-head-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 600;
  color: var(--text-muted);
  padding: 8rpx 0;
}

.cal-grid {
  display: flex;
  flex-direction: column;
}

.cal-row {
  display: flex;
  flex-direction: row;
}

.cal-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 0;
}

.cal-cell-out {
  opacity: 0.25;
}

.cal-cell-future {
  opacity: 0.35;
}

.cal-day-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-day-today {
  border-color: var(--green);
}

.cal-day-selected {
  background-color: var(--green);
  border-color: var(--green);
}

.cal-day-num {
  font-size: 26rpx;
  line-height: 34rpx;
  color: var(--text-primary);
}

.cal-day-num-strong {
  font-weight: 700;
}

.cal-day-num-inv {
  color: var(--text-inverse);
}

.cal-count {
  height: 24rpx;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 700;
  color: var(--green);
}

.cal-detail {
  margin-top: 24rpx;
  background-color: var(--bg-pill);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cal-detail-date {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.cal-detail-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.cal-detail-check {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 700;
  color: var(--green);
}

.cal-detail-name {
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--text-primary);
}

.cal-detail-empty {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-muted);
}

/* 7-Day Chart Card */
.chart-card {
  background-color: var(--bg-card-sage);
  border-radius: 36rpx;
  padding: 44rpx 36rpx;
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
}

.chart-summary {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.chart-number {
  font-size: 56rpx;
  line-height: 60rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.chart-sub-label {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-secondary);
}

.bars-container {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding: 0 10rpx;
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.bar-count-label {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-secondary);
  height: 24rpx;
}

.bar-track {
  width: 44rpx;
  height: 140rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.bar-fill {
  width: 100%;
  background-color: var(--chart-bar-bg);
  border-radius: 999rpx;
  transition: height 0.3s ease;
}

.bar-fill-active {
  background-color: var(--chart-bar-active);
}

.bar-day-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-muted);
  margin-top: 6rpx;
}

/* Milestone Card */
.milestone-card {
  background-color: var(--bg-card-mint);
  border-radius: 36rpx;
  padding: 40rpx 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.milestone-info {
  display: flex;
  flex-direction: column;
  max-width: 60%;
}

.milestone-title {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 800;
  color: var(--text-primary);
  white-space: pre-line;
  margin-bottom: 12rpx;
}

.milestone-days {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-secondary);
  white-space: pre-line;
}

.milestone-character {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Breakdown Section */
.breakdown-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.breakdown-title {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.breakdown-pill {
  border-radius: 999rpx;
  padding: 24rpx 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.pill-blue {
  background-color: var(--bg-card-blue);
}

.pill-sage {
  background-color: var(--bg-card-sage);
}

.breakdown-cat-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.breakdown-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.cal-detail-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.cal-detail-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
}

.cal-detail-name {
  flex: 1;
}

/* Share Poster Trigger */
.share-trigger-wrap {
  margin-top: 36rpx;
  width: 100%;
}

.share-trigger-btn {
  width: 100%;
  padding: 30rpx 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-trigger-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--btn-ink-text);
  letter-spacing: 0.5rpx;
}

/* Modal Overlay & Card */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(35, 35, 35, 0.55);
  backdrop-filter: blur(12rpx);
  z-index: 10000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-card {
  width: 100%;
  max-width: 100%;
  background-color: var(--bg-card);
  border-radius: 44rpx 44rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.modal-header {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-title-wrap {
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.modal-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.modal-close {
  font-size: 34rpx;
  color: var(--text-muted);
  padding: 8rpx 16rpx;
}

/* Poster Modal */
.poster-modal-card {
  width: 100%;
  max-width: 100%;
  background-color: var(--bg-card);
  border-radius: 44rpx 44rpx 0 0;
  padding: 40rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: slide-up 0.28s ease-out;
  display: flex;
  flex-direction: column;
  align-items: center;
  max-height: 92vh;
  z-index: 10001;
}

.poster-preview-box {
  width: 480rpx;
  height: 720rpx;
  max-height: 52vh;
  aspect-ratio: 2 / 3;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 44rpx rgba(35, 35, 35, 0.12);
  margin-bottom: 28rpx;
  background-color: #F6F5EE;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.poster-preview-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 28rpx;
}

.poster-loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.poster-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(79, 166, 90, 0.2);
  border-top-color: var(--green);
  border-radius: 50%;
  animation: poster-spin 0.8s linear infinite;
}

@keyframes poster-spin {
  to {
    transform: rotate(360deg);
  }
}

.poster-loading-text {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 600;
}

.poster-actions-dock {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.poster-secondary-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.action-dock-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-pill);
  border: none;
  outline: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  box-sizing: border-box;
}

.action-dock-btn::after {
  border: none;
}

.action-dock-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.sticker-publish-dock {
  flex: 1;
  display: block;
}

.save-album-btn {
  width: 100%;
  height: 96rpx;
  padding: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--btn-green-bg);
  box-shadow: 0 10rpx 28rpx rgba(79, 166, 90, 0.2);
}

.save-album-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--btn-green-text);
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* Off-screen Canvas for Poster Generation */
.poster-canvas-offscreen {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 360px;
  height: 560px;
  pointer-events: none;
  z-index: -9999;
}

@keyframes slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

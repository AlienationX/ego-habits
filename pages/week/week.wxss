/* pages/week/week.wxss */
.content-scroll {
  flex: 1;
  height: 100vh;
}

.page-body {
  padding-top: 40rpx;
  padding-left: 48rpx;
  padding-right: 48rpx;
  display: flex;
  flex-direction: column;
}

/* Header */
.header-section {
  padding-top: calc(70rpx + env(safe-area-inset-top));
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
}

.date-label {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.headline-title {
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

/* Week history pager (prev / range / next) — below the view toggle, chart mode only */
.week-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.week-nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.week-nav-btn-disabled {
  opacity: 0.35;
}

.week-nav-range {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
}

.tag-label {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

/* Quick "back to this week" pill, right-aligned in the toggle row */
.back-this-week-pill {
  margin-left: auto;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background-color: var(--btn-sage-bg);
}

.back-this-week-text {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: var(--btn-sage-text);
}

/* View toggle: chart / calendar */
.view-toggle {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.view-pill {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background-color: var(--bg-pill);
}

.view-pill-active {
  background-color: var(--btn-ink-bg);
}

.view-pill-text {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.view-pill-text-active {
  color: var(--btn-ink-text);
}

/* Calendar view */
.calendar-card {
  background-color: var(--bg-card);
  border-radius: 36rpx;
  padding: 36rpx;
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
}

.cal-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.cal-title {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.cal-head-row {
  display: flex;
  flex-direction: row;
  margin-bottom: 8rpx;
}

.cal-head-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 600;
  color: var(--text-muted);
  padding: 8rpx 0;
}

.cal-grid {
  display: flex;
  flex-direction: column;
}

.cal-row {
  display: flex;
  flex-direction: row;
}

.cal-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 0;
}

.cal-cell-out {
  opacity: 0.25;
}

.cal-cell-future {
  opacity: 0.35;
}

.cal-day-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-day-today {
  border-color: var(--green);
}

.cal-day-selected {
  background-color: var(--green);
  border-color: var(--green);
}

.cal-day-num {
  font-size: 26rpx;
  line-height: 34rpx;
  color: var(--text-primary);
}

.cal-day-num-strong {
  font-weight: 700;
}

.cal-day-num-inv {
  color: var(--text-inverse);
}

.cal-count {
  height: 24rpx;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 700;
  color: var(--green);
}

.cal-detail {
  margin-top: 24rpx;
  background-color: var(--bg-pill);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cal-detail-date {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.cal-detail-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.cal-detail-check {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 700;
  color: var(--green);
}

.cal-detail-name {
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--text-primary);
}

.cal-detail-empty {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-muted);
}

/* 7-Day Chart Card */
.chart-card {
  background-color: var(--bg-card-sage);
  border-radius: 36rpx;
  padding: 44rpx 36rpx;
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
}

.chart-summary {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.chart-number {
  font-size: 56rpx;
  line-height: 60rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.chart-sub-label {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-secondary);
}

.bars-container {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding: 0 10rpx;
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.bar-count-label {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-secondary);
  height: 24rpx;
}

.bar-track {
  width: 44rpx;
  height: 140rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.bar-fill {
  width: 100%;
  background-color: var(--chart-bar-bg);
  border-radius: 999rpx;
  transition: height 0.3s ease;
}

.bar-fill-active {
  background-color: var(--chart-bar-active);
}

.bar-day-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-muted);
  margin-top: 6rpx;
}

/* Milestone Card */
.milestone-card {
  background-color: var(--bg-card-mint);
  border-radius: 36rpx;
  padding: 40rpx 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.milestone-info {
  display: flex;
  flex-direction: column;
  max-width: 60%;
}

.milestone-title {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 800;
  color: var(--text-primary);
  white-space: pre-line;
  margin-bottom: 12rpx;
}

.milestone-days {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-secondary);
  white-space: pre-line;
}

.milestone-character {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Breakdown Section */
.breakdown-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.breakdown-title {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.breakdown-pill {
  border-radius: 999rpx;
  padding: 24rpx 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.pill-blue {
  background-color: var(--bg-card-blue);
}

.pill-sage {
  background-color: var(--bg-card-sage);
}

.breakdown-cat-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.breakdown-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* pages/week/week.wxss */
.content-scroll {
  flex: 1;
  height: 100vh;
}

.page-body {
  padding: 40rpx 40rpx 0;
  display: flex;
  flex-direction: column;
}

/* Header */
.header-section {
  padding-top: calc(70rpx + env(safe-area-inset-top));
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
}

.date-label {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.headline-title {
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

/* 7-Day Chart Card */
.chart-card {
  background-color: var(--bg-card-sage);
  border-radius: 36rpx;
  padding: 44rpx 36rpx;
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
}

.chart-summary {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.chart-number {
  font-size: 56rpx;
  line-height: 60rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.chart-sub-label {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-secondary);
}

.bars-container {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding: 0 10rpx;
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.bar-count-label {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-secondary);
  height: 24rpx;
}

.bar-track {
  width: 44rpx;
  height: 140rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.bar-fill {
  width: 100%;
  background-color: var(--chart-bar-bg);
  border-radius: 999rpx;
  transition: height 0.3s ease;
}

.bar-fill-active {
  background-color: var(--chart-bar-active);
}

.bar-day-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-muted);
  margin-top: 6rpx;
}

/* Milestone Card */
.milestone-card {
  background-color: var(--bg-card-mint);
  border-radius: 36rpx;
  padding: 40rpx 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.milestone-info {
  display: flex;
  flex-direction: column;
  max-width: 60%;
}

.milestone-title {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 800;
  color: var(--text-primary);
  white-space: pre-line;
  margin-bottom: 12rpx;
}

.milestone-days {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-secondary);
  white-space: pre-line;
}

.milestone-character {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Breakdown Section */
.breakdown-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.breakdown-title {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.breakdown-pill {
  border-radius: 999rpx;
  padding: 24rpx 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.pill-blue {
  background-color: var(--bg-card-blue);
}

.pill-sage {
  background-color: var(--bg-card-sage);
}

.breakdown-cat-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.breakdown-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

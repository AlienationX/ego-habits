/* pages/index/index.wxss - Today Tab Styles */

.content-scroll {
  flex: 1;
  height: 100vh;
}

.page-body {
  padding-top: 40rpx;
  padding-left: 48rpx;
  padding-right: 48rpx;
  display: flex;
  flex-direction: column;
}

/* ==================== HEADER ==================== */
.header-section {
  padding-top: calc(70rpx + env(safe-area-inset-top));
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
}

.date-label,
.tag-label {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.greeting-title,
.headline-title {
  font-size: 50rpx;
  line-height: 62rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

/* ==================== TODAY ==================== */
.hero-card {
  position: relative;
  background-color: var(--bg-card-sage);
  border-radius: 36rpx;
  padding: 32rpx 48rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 48rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(79, 166, 90, 0.08);
}

.hero-content {
  display: flex;
  flex-direction: column;
  z-index: 2;
  max-width: 55%;
}

.hero-title {
  font-size: 60rpx;
  line-height: 74rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -1rpx;
  white-space: pre-line;
  margin-bottom: 16rpx;
}

.hero-sub {
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--text-secondary);
  white-space: pre-line;
  margin-bottom: 24rpx;
}

.hero-btn {
  align-self: flex-start;
  padding: 28rpx 46rpx;
  font-size: 30rpx;
  border-radius: 24rpx;
}

.hero-btn-text {
  font-weight: 600;
  color: #FFFFFF;
}

.hero-character-wrap {
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.habit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.habit-card {
  border-radius: 32rpx;
  padding: 30rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  transition: transform 0.15s ease, opacity 0.15s ease;
  cursor: pointer;
}

.card-tint-blue {
  background-color: var(--bg-card-blue);
}

.card-tint-mint {
  background-color: var(--bg-card-mint);
}

.card-tint-sage {
  background-color: var(--bg-card-sage);
}

.card-tint-cream {
  background-color: var(--bg-card-cream);
}

.card-tint-mint-soft {
  background-color: var(--bg-card-mint-soft);
}

.card-tint-sage-soft {
  background-color: var(--bg-card-sage-soft);
}

.card-tint-blue-soft {
  background-color: var(--bg-card-blue-soft);
}

.card-character {
  width: 116rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.card-title {
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-right: 12rpx;
}

.badge-done {
  background-color: var(--green);
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-done-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.card-sub {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-secondary);
}

.card-action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 16rpx;
  flex-shrink: 0;
}

.card-completed {
  opacity: 0.75;
}

/* pages/index/index.wxss - Today Tab Styles */

.content-scroll {
  flex: 1;
  height: 100vh;
}

.page-body {
  padding-top: 40rpx;
  padding-left: 48rpx;
  padding-right: 48rpx;
  display: flex;
  flex-direction: column;
}

/* ==================== HEADER ==================== */
.header-section {
  padding-top: calc(70rpx + env(safe-area-inset-top));
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
}

.date-label,
.tag-label {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.greeting-title,
.headline-title {
  font-size: 50rpx;
  line-height: 62rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

/* ==================== TODAY ==================== */
.hero-card {
  position: relative;
  background-color: var(--bg-card-sage);
  border-radius: 36rpx;
  padding: 32rpx 48rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 48rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(79, 166, 90, 0.08);
}

.hero-content {
  display: flex;
  flex-direction: column;
  z-index: 2;
  max-width: 55%;
}

.hero-title {
  font-size: 60rpx;
  line-height: 74rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -1rpx;
  white-space: pre-line;
  margin-bottom: 16rpx;
}

.hero-sub {
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--text-secondary);
  white-space: pre-line;
  margin-bottom: 24rpx;
}

.hero-btn {
  align-self: flex-start;
  padding: 28rpx 46rpx;
  font-size: 30rpx;
  border-radius: 24rpx;
}

.hero-btn-text {
  font-weight: 600;
  color: #FFFFFF;
}

.hero-character-wrap {
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.section-header {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background-color: var(--bg-pill);
}

.section-action-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.habit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.habit-card {
  border-radius: 32rpx;
  padding: 30rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  transition: transform 0.15s ease, opacity 0.15s ease;
  cursor: pointer;
}

.card-tint-blue {
  background-color: var(--bg-card-blue);
}

.card-tint-mint {
  background-color: var(--bg-card-mint);
}

.card-tint-sage {
  background-color: var(--bg-card-sage);
}

.card-tint-cream {
  background-color: var(--bg-card-cream);
}

.card-tint-mint-soft {
  background-color: var(--bg-card-mint-soft);
}

.card-tint-sage-soft {
  background-color: var(--bg-card-sage-soft);
}

.card-tint-blue-soft {
  background-color: var(--bg-card-blue-soft);
}

.card-character {
  width: 116rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.card-title {
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-right: 12rpx;
}

.badge-done {
  background-color: var(--green);
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-done-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.card-sub {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-secondary);
}

.card-action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 16rpx;
  flex-shrink: 0;
}

.card-completed {
  opacity: 0.75;
}

/* ==================== MANAGE TODAY BOTTOM SHEET MODAL ==================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8px);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  animation: overlay-fade 0.2s ease;
}

@keyframes overlay-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-card {
  background-color: var(--bg-card);
  border-top-left-radius: 44rpx;
  border-top-right-radius: 44rpx;
  padding: 40rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.12);
  animation: sheet-slide-up 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes sheet-slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.modal-title-group,
.modal-title-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.modal-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 48rpx;
}

.modal-sub {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 32rpx;
}

.modal-close,
.modal-close-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: var(--bg-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1;
}

.modal-body-scroll {
  flex: 1;
  max-height: 54vh;
  margin-bottom: 24rpx;
}

.manage-section-title-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.manage-section-title-wrap.mt-28 {
  margin-top: 28rpx;
}

.manage-section-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-muted);
  letter-spacing: 1rpx;
}

.manage-count-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--green);
  background-color: rgba(79, 166, 90, 0.12);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.manage-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.manage-habit-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.manage-item-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
}

.manage-item-char {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.manage-item-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.manage-item-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 36rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manage-item-sub {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manage-action-pill {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  cursor: pointer;
}

.pill-remove {
  background-color: rgba(35, 35, 35, 0.08);
  border: 1rpx solid rgba(35, 35, 35, 0.1);
}

.pill-remove .text-remove {
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.pill-add {
  background-color: var(--btn-ink-bg);
}

.pill-add .text-add {
  color: var(--btn-ink-text);
  font-size: 24rpx;
  font-weight: 700;
}

/* Dark mode overrides for modal */
.theme-dark .pill-remove {
  background-color: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.theme-dark .pill-remove .text-remove {
  color: #EDEFEA;
}

.modal-footer-wrap {
  padding-top: 12rpx;
}

.manage-done-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--btn-ink-bg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  cursor: pointer;
}

.manage-done-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--btn-ink-text);
}


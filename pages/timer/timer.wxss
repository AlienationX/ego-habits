/* pages/timer/timer.wxss */
.page-body {
  min-height: 100vh;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-header {
  padding-top: 0;
  width: 100%;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.headline-title {
  font-size: 42rpx;
  line-height: 52rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

.character-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0 8rpx;
}

.countdown-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.countdown {
  font-size: 120rpx;
  line-height: 140rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -3rpx;
  font-variant-numeric: tabular-nums;
}

.hint {
  font-size: 26rpx;
  line-height: 38rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* Soundscape Selector */
.soundscape-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.soundscape-label {
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 16rpx;
}

.soundscape-pills {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
}

.soundscape-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background-color: var(--bg-pill);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  transition: all 0.2s ease;
}

.soundscape-pill-active {
  background-color: var(--btn-ink-bg);
}

.soundscape-pill-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.soundscape-pill-active .soundscape-pill-text {
  color: var(--btn-ink-text);
}

.controls {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: auto;
  padding-top: 24rpx;
}

.primary-btn {
  width: 100%;
  padding: 32rpx 0;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(35, 35, 35, 0.16);
}

.primary-btn-text {
  font-size: 30rpx;
  font-weight: 700;
}

.end-btn {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 999rpx;
}

.end-btn-text {
  font-size: 28rpx;
  font-weight: 700;
}

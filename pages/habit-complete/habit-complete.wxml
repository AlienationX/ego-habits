<!-- pages/habit-complete/habit-complete.wxml -->
<view class="page-container {{themeClass}}">
  <scroll-view class="content-scroll" scroll-y enable-passive>
    <view class="page-body safe-bottom">
      
      <!-- Top Bar (back button) -->
      <view class="topbar">
        <nav-back />
      </view>

      <!-- Top Title -->
      <view class="nav-header">
        <text class="tag-label">{{tTag}}</text>
        <text class="headline-title">{{tHeadline}}</text>
      </view>

      <!-- Center Celebration: green check badge + confetti (water keeps its character) -->
      <view class="celebration-center {{useBadge ? 'celebration-badge' : ''}}">
        <block wx:if="{{useBadge}}">
          <view class="confetti-layer">
            <view
              wx:for="{{confetti}}"
              wx:key="index"
              class="confetti {{item.shape}}"
              style="left: {{item.x}}%; top: {{item.y}}%; width: {{item.w}}rpx; height: {{item.h}}rpx; background-color: {{item.color}}; animation-delay: {{item.d}}s;"
            ></view>
          </view>
          <view class="award-badge">
            <view class="check-mark"></view>
          </view>
        </block>
        <view wx:else class="char-bounce">
          <habit-character name="celebrate" size="420" animate="{{true}}" />
        </view>
      </view>

      <!-- Metric Count & Progress Bar -->
      <view class="metric-section">
        <text class="metric-val">{{metricAdded}}</text>
        <text class="metric-label">{{tMetricLabel}}</text>
        <text wx:if="{{note}}" class="metric-note">{{note}}</text>
        
        <view class="progress-track">
          <view class="progress-bar {{barAnimated ? 'progress-bar-fill' : ''}}"></view>
        </view>
      </view>

      <!-- Encouragement Card -->
      <view class="encouragement-card">
        <text class="card-title">{{tCardTitle}}</text>
        <text class="card-sub">{{tCardSub}}</text>
      </view>

      <!-- Dual Action Buttons -->
      <view class="actions-row">
        <view class="btn-moru btn-ink action-btn" hover-class="press" hover-stay-time="120" bindtap="onBackToToday">
          <text class="action-btn-text">{{tBtnBack}}</text>
        </view>
        <view class="btn-moru btn-sage action-btn" hover-class="press" hover-stay-time="120" bindtap="onViewWeek">
          <text class="action-btn-text btn-text-dark">{{tBtnViewWeek}}</text>
        </view>
      </view>

      <!-- Slogan Footer -->
      <view class="footer-wrap">
        <text class="footer-text">{{tFooterText}}</text>
      </view>

    </view>
  </scroll-view>
</view>

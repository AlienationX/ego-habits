/* pages/habit-complete/habit-complete.wxss */
.content-scroll {
  flex: 1;
  height: 100vh;
}

.page-body {
  padding: 40rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Nav Header (safe-area handled by .topbar above) */
.nav-header {
  padding-top: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  margin-bottom: 30rpx;
  animation: rise-in 0.45s ease 0s both;
}

.tag-label {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.headline-title {
  font-size: 48rpx;
  line-height: 58rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

/* Center Celebration Character */
.celebration-center {
  margin: 30rpx 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Award badge + confetti (non-water habits) */
.celebration-badge {
  position: relative;
  width: 100%;
  height: 420rpx;
}

.confetti-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.confetti {
  position: absolute;
  border-radius: 6rpx;
  opacity: 0.9;
  animation: confetti-sway 2.6s ease-in-out infinite alternate;
}

.confetti.dot {
  border-radius: 50%;
}

@keyframes confetti-sway {
  from {
    transform: translateY(-8rpx);
    opacity: 0.7;
  }
  to {
    transform: translateY(10rpx);
    opacity: 0.95;
  }
}

.award-badge {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background-color: var(--green);
  border: 8rpx solid var(--bg-card);
  box-shadow: 0 16rpx 40rpx rgba(35, 35, 35, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: pop-in 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both;
}

.check-mark {
  width: 100rpx;
  height: 56rpx;
  border-left: 14rpx solid #FFFFFF;
  border-bottom: 14rpx solid #FFFFFF;
  border-radius: 6rpx;
  transform: rotate(-45deg);
  margin-top: -12rpx;
}

/* Entrance & idle animations (shared by all completion pages) */
.char-bounce {
  display: flex;
  align-items: center;
  justify-content: center;
  animation: soft-bounce 1.8s ease-in-out infinite;
}

@keyframes pop-in {
  0% {
    transform: scale(0);
    opacity: 0;
  }
  60% {
    transform: scale(1.12);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes rise-in {
  from {
    transform: translateY(24rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes soft-bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-16rpx);
  }
}

/* Metric Section */
.metric-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  animation: rise-in 0.5s ease 0.25s both;
}

.metric-val {
  font-size: 56rpx;
  line-height: 64rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -1rpx;
  margin-bottom: 6rpx;
}

.metric-label {
  font-size: 26rpx;
  line-height: 34rpx;
  color: var(--text-secondary);
  margin-bottom: 28rpx;
}

.metric-note {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-secondary);
  margin-top: -18rpx;
  margin-bottom: 28rpx;
}

/* Progress Track & Fill */
.progress-track {
  width: 100%;
  height: 12rpx;
  background-color: var(--progress-bg);
  border-radius: 999rpx;
  overflow: hidden;
  position: relative;
}

.progress-bar {
  height: 100%;
  width: 0%;
  background-color: var(--progress-fill);
  border-radius: 999rpx;
  transition: width 1s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.progress-bar-fill {
  width: 100%;
}

/* Encouragement Card */
.encouragement-card {
  width: 100%;
  background-color: var(--bg-card-sage);
  border-radius: 32rpx;
  padding: 36rpx 36rpx;
  display: flex;
  flex-direction: column;
  margin-bottom: 48rpx;
  animation: rise-in 0.5s ease 0.35s both;
}

.card-title {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--text-secondary);
  white-space: pre-line;
}

/* Dual Action Buttons */
.actions-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  margin-bottom: 48rpx;
  animation: rise-in 0.5s ease 0.45s both;
}

.action-btn {
  flex: 1;
  padding: 28rpx 0;
  border-radius: 999rpx;
}

.action-btn-text {
  font-size: 28rpx;
  font-weight: 700;
}

.btn-text-dark {
  color: #232323;
}

/* Footer Slogan */
.footer-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 20rpx;
  animation: rise-in 0.5s ease 0.55s both;
}

.footer-text {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-muted);
}

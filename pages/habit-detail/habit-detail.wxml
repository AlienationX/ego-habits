<!-- pages/habit-detail/habit-detail.wxml -->
<view class="page-container {{themeClass}}">
  <scroll-view class="content-scroll" scroll-y enable-passive>
    <view class="page-body">

      <!-- Top Bar (back button) -->
      <view class="topbar">
        <nav-back />
      </view>

      <!-- Top Title -->
      <view class="nav-header">
        <text class="tag-label">{{tTag}}</text>
        <text class="headline-title">{{tHeadline}}</text>
      </view>

      <!-- Hero Card -->
      <view class="hero-card card-tint-{{habit.tint || 'blue'}}">
        <view class="hero-text-wrap">
          <text class="hero-title">{{tHeroTitle}}</text>
          <text class="hero-sub">{{tHeroSub}}</text>
        </view>
        <view class="hero-character-wrap">
          <habit-character name="{{habit.character || 'water'}}" size="200" animate="{{true}}" />
        </view>
      </view>

      <!-- 2-Column Metrics -->
      <view class="metrics-row">
        <view class="metric-col">
          <text class="metric-val">{{displayAmount}}</text>
          <text class="metric-label">{{tMetricAmountLabel}}</text>
        </view>
        <view class="metric-col">
          <text class="metric-val">{{tMetricRhythm}}</text>
          <text class="metric-label">{{tMetricRhythmLabel}}</text>
        </view>
      </view>

      <!-- Edit default (opens a popup, no layout shift) -->
      <view class="edit-default-row" hover-class="press-soft" hover-stay-time="120" bindtap="onOpenEditor">
        <text class="edit-default-label">{{tEditDefault}}</text>
        <habit-icon name="arrow" size="28" color="var(--text-muted)" />
      </view>

      <view class="divider-line"></view>

      <!-- Guide: Keep it easy -->
      <view class="guide-section">
        <text class="guide-title">{{tGuideTitle}}</text>

        <view class="steps-list">
          <view wx:for="{{steps}}" wx:key="num" class="step-item">
            <view class="step-badge">
              <text class="step-num">{{item.num}}</text>
            </view>
            <view class="step-content">
              <text class="step-title">{{item.title}}</text>
              <text class="step-desc">{{item.desc}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- CTA Button -->
      <view class="cta-wrap">
        <view
          class="btn-moru cta-btn {{habit.module ? 'cta-module' : (isCompleted ? 'btn-ink cta-completed' : 'btn-ink')}}"
          hover-class="press"
          hover-stay-time="120"
          bindtap="onLogHabit"
        >
          <text class="cta-btn-text">{{isCompleted && !habit.module ? tAlreadyLogged : tLogButton}}</text>
        </view>
      </view>

    </view>
  </scroll-view>

  <!-- Edit default popup -->
  <view wx:if="{{showEditor}}" class="editor-mask" bindtap="onCloseEditor">
    <view class="editor-card" catchtap="noop">
      <text class="editor-title">{{tEditDefault}}</text>

      <view class="editor-row">
        <text class="checkin-label">{{tAmountLabel}}</text>
        <view class="stepper">
          <view class="stepper-btn" hover-class="press-soft" hover-stay-time="100" bindtap="onDecreaseAmount">
            <text class="stepper-sign">−</text>
          </view>
          <view class="stepper-value-wrap">
            <text class="stepper-value">{{amountValue}}</text>
            <text class="stepper-unit">{{amountUnitLabel}}</text>
          </view>
          <view class="stepper-btn" hover-class="press-soft" hover-stay-time="100" bindtap="onIncreaseAmount">
            <text class="stepper-sign">+</text>
          </view>
        </view>
      </view>

      <view class="editor-row editor-note-row">
        <text class="checkin-label">{{tNoteLabel}}</text>
        <input
          class="note-input"
          value="{{noteValue}}"
          placeholder="{{tNotePlaceholder}}"
          placeholder-class="note-placeholder"
          maxlength="60"
          bindinput="onNoteInput"
        />
      </view>

      <view class="editor-actions">
        <view class="btn-moru btn-sage editor-btn" hover-class="press" hover-stay-time="120" bindtap="onCloseEditor">
          <text class="editor-btn-text">{{tCancel}}</text>
        </view>
        <view class="btn-moru btn-ink editor-btn" hover-class="press" hover-stay-time="120" bindtap="onConfirmEditor">
          <text class="editor-btn-text">{{tSave}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

/* pages/habit-detail/habit-detail.wxss */
.content-scroll {
  flex: 1;
  height: 100vh;
}

.page-body {
  padding: 40rpx 40rpx 0;
  display: flex;
  flex-direction: column;
}

/* Nav Header (safe-area handled by .topbar above) */
.nav-header {
  padding-top: 0;
  margin-bottom: 36rpx;
  display: flex;
  flex-direction: column;
}

.tag-label {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 6rpx;
}

.headline-title {
  font-size: 46rpx;
  line-height: 56rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

/* Hero Card */
.hero-card {
  border-radius: 36rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.card-tint-blue {
  background-color: var(--bg-card-blue);
}

.card-tint-mint {
  background-color: var(--bg-card-mint);
}

.card-tint-sage {
  background-color: var(--bg-card-sage);
}

.card-tint-cream {
  background-color: var(--bg-card-cream);
}

.card-tint-mint-soft {
  background-color: var(--bg-card-mint-soft);
}

.card-tint-sage-soft {
  background-color: var(--bg-card-sage-soft);
}

.card-tint-blue-soft {
  background-color: var(--bg-card-blue-soft);
}

.hero-text-wrap {
  display: flex;
  flex-direction: column;
  max-width: 58%;
}

.hero-title {
  font-size: 40rpx;
  line-height: 50rpx;
  font-weight: 800;
  color: var(--text-primary);
  white-space: pre-line;
  margin-bottom: 16rpx;
}

.hero-sub {
  font-size: 26rpx;
  line-height: 38rpx;
  color: var(--text-secondary);
  white-space: pre-line;
}

.hero-character-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -10rpx;
}

/* 2-Column Metrics: equal-width columns, both left-aligned */
.metrics-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}

.metric-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.metric-val {
  font-size: 38rpx;
  line-height: 48rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 4rpx;
  white-space: nowrap;
}

.metric-label {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

/* Edit-default toggle row (shows the amount/note editor) */
.edit-default-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.edit-default-label {
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--text-secondary);
}

.divider-line {
  height: 1rpx;
  background-color: var(--border-light);
  width: 100%;
  margin-bottom: 36rpx;
}

/* Edit-default popup */
.editor-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(35, 35, 35, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.editor-card {
  width: 80%;
  max-width: 600rpx;
  background-color: var(--bg-card);
  border-radius: 36rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

.editor-title {
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 32rpx;
}

.editor-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.editor-note-row {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.editor-actions {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  margin-top: 8rpx;
}

.editor-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 999rpx;
}

.editor-btn-text {
  font-size: 28rpx;
  font-weight: 700;
}

.checkin-label {
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--bg-pill);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-sign {
  font-size: 40rpx;
  line-height: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.stepper-value-wrap {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 8rpx;
  min-width: 140rpx;
  justify-content: center;
}

.stepper-value {
  font-size: 36rpx;
  line-height: 44rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.stepper-unit {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-secondary);
}

.note-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background-color: var(--bg-pill);
  font-size: 28rpx;
  color: var(--text-primary);
}

.note-placeholder {
  color: var(--text-muted);
}

/* Module entry (breathing / timer) */
.module-entry {
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.module-entry-title {
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* Guide: Keep it easy */
.guide-section {
  display: flex;
  flex-direction: column;
  margin-bottom: 44rpx;
}

.guide-title {
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 28rpx;
}

.steps-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.step-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.step-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: var(--bg-card-sage);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.step-num {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.step-content {
  display: flex;
  flex-direction: column;
}

.step-title {
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.step-desc {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-secondary);
}

/* CTA Wrap */
.cta-wrap {
  width: 100%;
  margin-bottom: 32rpx;
}

/* Flat CTA, shared by all habits (matches the app's card style) */
.cta-btn {
  width: 100%;
  padding: 32rpx 0;
  border-radius: 32rpx;
  box-shadow: none;
}

/* Module-practice CTA: token green */
.cta-module {
  background-color: var(--btn-green-bg);
  color: var(--btn-green-text);
}

.cta-btn-text {
  font-size: 30rpx;
  font-weight: 700;
}

.cta-completed {
  background-color: var(--green);
  opacity: 0.9;
}

.delete-habit-wrap {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
}

.delete-habit-text {
  font-size: 26rpx;
  color: #FF5A5F;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

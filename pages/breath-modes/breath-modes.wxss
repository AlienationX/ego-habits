/* pages/breath-modes/breath-modes.wxss */
.content-scroll {
  flex: 1;
  height: 100vh;
}

.page-body {
  padding: 40rpx 40rpx 0;
  display: flex;
  flex-direction: column;
}

.nav-header {
  padding-top: 0;
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
}

.tag-label {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.headline-title {
  font-size: 46rpx;
  line-height: 56rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

/* Card tints */
.card-tint-blue { background-color: var(--bg-card-blue); }
.card-tint-mint { background-color: var(--bg-card-mint); }
.card-tint-sage { background-color: var(--bg-card-sage); }
.card-tint-cream { background-color: var(--bg-card-cream); }
.card-tint-mint-soft { background-color: var(--bg-card-mint-soft); }
.card-tint-sage-soft { background-color: var(--bg-card-sage-soft); }
.card-tint-blue-soft { background-color: var(--bg-card-blue-soft); }

/* Mode cards */
.mode-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.mode-card {
  position: relative;
  border-radius: 32rpx;
  padding: 32rpx 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  border: 2rpx solid transparent;
  transition: border-color 0.2s ease, transform 0.15s ease, opacity 0.15s ease;
}

.mode-card-active {
  border-color: var(--border-focus);
}

.mode-info {
  display: flex;
  flex-direction: column;
  max-width: 78%;
  z-index: 2;
}

.mode-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.mode-name {
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.in-use-badge {
  background-color: var(--btn-ink-bg);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.in-use-text {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--btn-ink-text);
}

.mode-pattern {
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.mode-desc {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-muted);
}

.mode-dot {
  position: absolute;
  right: -40rpx;
  bottom: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.35);
  z-index: 1;
}

/* Free breathing panel */
.free-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
  background-color: var(--bg-card);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
}

.free-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.free-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: var(--bg-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.step-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

.step-val {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  min-width: 56rpx;
  text-align: center;
}

/* Disclaimer */
.disclaimer {
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--text-muted);
  margin-bottom: 28rpx;
}

/* Start CTA */
.start-wrap {
  width: 100%;
  margin-bottom: 32rpx;
}

.start-btn {
  width: 100%;
  padding: 32rpx 0;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(35, 35, 35, 0.16);
}

.start-text {
  font-size: 30rpx;
  font-weight: 700;
}

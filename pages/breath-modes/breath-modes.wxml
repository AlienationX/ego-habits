<!-- pages/breath-modes/breath-modes.wxml -->
<view class="page-container {{themeClass}}">
  <scroll-view class="content-scroll" scroll-y enable-passive>
    <view class="page-body safe-bottom">

      <view class="topbar">
        <nav-back />
      </view>

      <view class="nav-header">
        <text class="tag-label">{{tTag}}</text>
        <text class="headline-title">{{tHeadline}}</text>
      </view>

      <!-- Mode cards -->
      <view class="mode-list">
        <view
          wx:for="{{modes}}"
          wx:key="id"
          class="mode-card card-tint-{{item.tint}} {{selected === item.id ? 'mode-card-active' : ''}}"
          hover-class="press-soft"
          hover-stay-time="120"
          data-id="{{item.id}}"
          bindtap="onSelectMode"
        >
          <view class="mode-info">
            <view class="mode-name-row">
              <text class="mode-name">{{item.name}}</text>
              <view wx:if="{{item.inUse}}" class="in-use-badge">
                <text class="in-use-text">{{tCurrent}}</text>
              </view>
            </view>
            <text class="mode-pattern">{{item.pattern}}</text>
            <text class="mode-desc">{{item.desc}}</text>
          </view>
          <view class="mode-dot"></view>
        </view>
      </view>

      <text class="disclaimer">{{tDisclaimer}}</text>

    </view>
  </scroll-view>

  <!-- Free breathing config sheet -->
  <view wx:if="{{showFreeSheet}}" class="sheet-mask" bindtap="onCloseFreeSheet">
    <view class="sheet-card" catchtap="noop">
      <text class="sheet-title">{{tFreeTitle}}</text>
      <text class="sheet-hint">{{tFreeHint}}</text>

      <view class="slider-row">
        <view class="slider-head">
          <text class="slider-label">{{tInhale}}</text>
          <text class="slider-val">{{freeIn}}{{tSecUnit}}</text>
        </view>
        <slider min="1" max="10" step="1" value="{{freeIn}}" activeColor="{{sliderColor}}" backgroundColor="var(--bg-pill)" block-size="24" data-field="freeIn" bindchanging="onFreeSlider" bindchange="onFreeSlider" />
      </view>

      <view class="slider-row">
        <view class="slider-head">
          <text class="slider-label">{{tFreeHoldIn}}</text>
          <text class="slider-val">{{freeHold}}{{tSecUnit}}</text>
        </view>
        <slider min="0" max="10" step="1" value="{{freeHold}}" activeColor="{{sliderColor}}" backgroundColor="var(--bg-pill)" block-size="24" data-field="freeHold" bindchanging="onFreeSlider" bindchange="onFreeSlider" />
      </view>

      <view class="slider-row">
        <view class="slider-head">
          <text class="slider-label">{{tExhale}}</text>
          <text class="slider-val">{{freeOut}}{{tSecUnit}}</text>
        </view>
        <slider min="1" max="10" step="1" value="{{freeOut}}" activeColor="{{sliderColor}}" backgroundColor="var(--bg-pill)" block-size="24" data-field="freeOut" bindchanging="onFreeSlider" bindchange="onFreeSlider" />
      </view>

      <view class="slider-row">
        <view class="slider-head">
          <text class="slider-label">{{tFreeHoldOut}}</text>
          <text class="slider-val">{{freeHoldOut}}{{tSecUnit}}</text>
        </view>
        <slider min="0" max="10" step="1" value="{{freeHoldOut}}" activeColor="{{sliderColor}}" backgroundColor="var(--bg-pill)" block-size="24" data-field="freeHoldOut" bindchanging="onFreeSlider" bindchange="onFreeSlider" />
      </view>

      <view class="slider-row">
        <view class="slider-head">
          <text class="slider-label">{{tFreeDuration}}</text>
          <text class="slider-val">{{freeDurMin}} {{tMinUnit}}</text>
        </view>
        <slider min="1" max="10" step="1" value="{{freeDurMin}}" activeColor="{{sliderColor}}" backgroundColor="var(--bg-pill)" block-size="24" data-field="freeDurMin" bindchanging="onFreeSlider" bindchange="onFreeSlider" />
      </view>

      <view class="free-summary">
        <text class="free-summary-seq">{{freeSummarySeq}}</text>
        <text class="free-summary-sub">{{freeSummarySub}}</text>
      </view>

      <view class="btn-moru btn-ink sheet-btn" hover-class="press" hover-stay-time="120" bindtap="onStartFree">
        <text class="sheet-btn-text">{{tFreeSave}}</text>
      </view>
    </view>
  </view>
</view>
